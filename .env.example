# Copy this file to .env and adjust as needed. All values below are defaults.

# --- GitHub ingestion ---
# Repos are listed/cloned via the `gh` CLI, which must already be authenticated
# (run `gh auth login` once if `gh auth status` doesn't show a logged-in account).
GITHUB_USERNAME=sultanmaliki
INCLUDE_FORKS=false

# --- Website ingestion ---
WEBSITE_ROOT_DOMAIN=syedmohammedsultan.online
# Comma-separated seed URLs to start crawling from.
WEBSITE_SEED_URLS=https://syedmohammedsultan.online
# Auto-discover live subdomains via public certificate-transparency logs (crt.sh).
WEBSITE_DISCOVER_SUBDOMAINS=true
WEBSITE_MAX_PAGES=300

# --- Storage ---
CHROMA_DIR=./data/chroma
REPOS_DIR=./data/repos
COLLECTION_NAME=personal_knowledge
CONVERSATIONS_DB=./data/conversations.db

# --- Embeddings (local, via sentence-transformers) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM (local, via Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# --- Chunking / retrieval ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
